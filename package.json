{
	"name": "n8n-nodes-rephonic",
	"version": "0.1.0",
	"description": "Rephonic nodes for n8n: search podcasts, get podcast details, and check API quota",
	"license": "MIT",
	"homepage": "https://rephonic.com",
	"keywords": [
		"n8n-community-node-package",
		"rephonic",
		"podcast"
	],
	"author": {
		"name": "James Potter",
		"email": "support@rephonic.com",
		"url": "https://rephonic.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/getrephonic/n8n-nodes-rephonic.git"
	},
	"bugs": {
		"url": "https://github.com/getrephonic/n8n-nodes-rephonic/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test tests/*.test.cjs",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist/credentials",
		"dist/icons",
		"dist/nodes"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/RephonicApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Rephonic/Rephonic.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.6",
		"eslint": "9.39.4",
		"n8n-workflow": "2.45.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
